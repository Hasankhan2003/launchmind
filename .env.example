# ─────────────────────────────────────────────────────────────
#  LaunchMind — Environment Variables
#  Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# ── Groq LLM ──────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── GitHub ────────────────────────────────────────────────────
# Personal Access Token with repo + pull request permissions
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Repository in "owner/repo" format (must already exist)
GITHUB_REPO=your_username/your_repo_name

# Base branch to create the feature branch from
GITHUB_BRANCH=main

# ── Slack ─────────────────────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-)
# Create a Slack App at: https://api.slack.com/apps
# Required scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Channel to post messages to (e.g. #launches or a channel ID)
SLACK_CHANNEL=#launches

# ── SendGrid (Email) ──────────────────────────────────────────
# API Key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Verified sender email (must be verified in SendGrid)
SENDER_EMAIL=your_verified_sender@example.com

# Recipient for cold email demo
RECEIVER_EMAIL=recipient@example.com
